# Build stage
FROM node:20-alpine AS build
WORKDIR /app

# Copy package files
COPY src/ClinIQ.Web/package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source code
COPY src/ClinIQ.Web/ ./

# Build Angular app for production
RUN npm run build -- --configuration production

# Runtime stage
FROM nginx:alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Non-root-safe config (unprivileged ports, /tmp pid, logs to stdout/stderr).
# Baked at build time so the entrypoint never has to write to /etc.
COPY docker/nginx.web.conf /etc/nginx/nginx.conf

# Copy built Angular app
COPY --from=build /app/dist/cliniq-web/browser /usr/share/nginx/html

RUN adduser -D -H -u 1000 -s /sbin/nologin nginx-user && \
    chown -R nginx-user:nginx-user /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
